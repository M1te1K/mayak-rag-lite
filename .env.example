# Groq: keep your account on Free Plan. Never paste a key into chat or Git.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Groq supports strict schema; selected OpenRouter free model uses prompted JSON.
LLM_JSON_MODE=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
PDF_PATH=output/pdf/mayak-demo.pdf
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MODEL_CACHE_DIR=.cache/models
CHUNK_TOKENS=220
CHUNK_OVERLAP=32
RETRIEVAL_TOP_K=3
RETRIEVAL_EXPANDED_K=6
CONTEXT_MAX_CHARS=4800
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=4000
INPUT_MAX_CHARS=2000
LOG_PATH=logs/bot.jsonl
CLI_USER_ID=cli-local
